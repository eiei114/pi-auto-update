{
  "name": "pi-auto-update",
  "version": "0.1.8",
  "description": "Stage Pi package updates and install only after dependency scanning and independent AI security review.",
  "type": "module",
  "license": "MIT",
  "author": "eiei114",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "auto-update",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-auto-update.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-auto-update/issues"
  },
  "homepage": "https://github.com/eiei114/pi-auto-update#readme",
  "files": [
    "extensions/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "publish:guard": "node scripts/check-no-npm-token.mjs",
    "pack:check": "npm pack --dry-run",
    "ci": "npm run typecheck && npm run smoke:pi && npm test && npm run publish:guard && npm run pack:check",
    "test:installed-smoke": "node --test tests/installed-package-smoke.test.mjs",
    "test:network": "node --test tests/real-npm.integration.mjs",
    "smoke:pi": "node scripts/pi-sdk-smoke.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/auto-update.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  }
}
