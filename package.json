{
  "name": "pi-auto-update",
  "version": "0.1.0",
  "description": "Automatically update installed Pi packages and Pi itself when a Pi session starts.",
  "type": "module",
  "license": "MIT",
  "author": "eiei114",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "auto-update",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-auto-update.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-auto-update/issues"
  },
  "homepage": "https://github.com/eiei114/pi-auto-update#readme",
  "files": [
    "extensions/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "publish:guard": "node scripts/check-no-npm-token.mjs",
    "pack:check": "npm pack --dry-run",
    "ci": "npm run typecheck && npm test && npm run publish:guard && npm run pack:check"
  },
  "pi": {
    "extensions": [
      "./extensions/auto-update.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  }
}
